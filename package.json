{
  "name": "dsh-launcher",
  "version": "1.17.1",
  "description": "Desktop launcher (Electron) for DeepSeek Harness: opens dsh web in a window, stops dsh on exit",
  "main": "main.js",
  "scripts": {
    "start": "sh run.sh",
    "test": "eslint . && node --test test/*.js test/smoke/*.js",
    "icon": "node make-icon.js",
    "banner": "electron make-banner.js --no-sandbox",
    "lint": "eslint .",
    "release": "node release.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/*' --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=100 test/*.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "electron": "^44.9.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
