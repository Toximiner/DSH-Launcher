{
  "name": "dsh-launcher",
  "version": "1.15.9",
  "description": "Desktop launcher (Electron) for DeepSeek Harness: opens dsh web in a window, stops dsh on exit",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "eslint . && node --test test/*.js",
    "icon": "node make-icon.js",
    "banner": "electron make-banner.js --no-sandbox",
    "lint": "eslint .",
    "release": "node release.js",
    "coverage": "node --test --experimental-test-coverage test/*.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "electron": "^44.7.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
